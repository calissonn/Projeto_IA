# Modo de execução: demo (sem IA, sem custo) ou real (Claude Code de verdade, gera custos)
ACC_MODE=demo
# Orquestrador escuta apenas em 127.0.0.1
ACC_PORT=4317
# Token local exigido pela API e pelo WebSocket. Gere um valor aleatório longo.
ACC_TOKEN=troque-por-um-valor-aleatorio
# Origem permitida (aplicação web)
ACC_ALLOWED_ORIGIN=http://localhost:3000
# Quantas tarefas podem rodar ao mesmo tempo
ACC_MAX_CONCURRENCY=2
# Velocidade do modo demonstração (1 = normal, 2 = duas vezes mais rápido)
ACC_DEMO_SPEED=1
# --- Modo real (Claude Code via Agent SDK) ---
# Modelo dos agentes (alias aceito pelo Claude Code)
ACC_MODEL=sonnet
# Limites de custo em US$: por tarefa, por projeto e por planejamento
ACC_TASK_BUDGET_USD=0.5
ACC_PROJECT_BUDGET_USD=2
ACC_PLAN_BUDGET_USD=0.3
# Limite de turnos por tarefa
ACC_MAX_TURNS=40
# Sandbox do Bash: auto (usa se disponível), required (recusa rodar sem), off (desligado)
ACC_SANDBOX=auto
# Pasta dos workspaces dos projetos (padrão: ./workspaces)
# ACC_WORKSPACES_DIR=
# Caminho do executável do Claude Code, se precisar forçar um específico
# ACC_CLAUDE_PATH=
# ANTHROPIC_API_KEY=  (opcional: sem ela, usa o login do Claude Code da máquina — `claude login`)
# Preço do modelo para a estimativa de custo (US$ por milhão de tokens). Padrão: Claude Sonnet 5.5.
ACC_PRICE_INPUT_PER_MTOK=2
ACC_PRICE_OUTPUT_PER_MTOK=10
